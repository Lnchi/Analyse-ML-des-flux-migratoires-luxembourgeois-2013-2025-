# Copier ce fichier en ".env" et adapter si besoin.
# Répertoire de cache local pour les séries EUROSTAT téléchargées
# (remplace le montage Google Drive de la version Colab).
CACHE_DIR=data/cache/

# Forcer le retéléchargement des séries même si un cache existe (true/false)
FORCE_DOWNLOAD=false

# Sauvegarder automatiquement les figures dans outputs/figures/ (true/false)
SAVE_FIGURES=true
